# Writes gta2_compat.h: a hash of everything that decides what the game simulates (the game sources,
# the port's headers and its C runtime, which holds rand()). Two builds with the same hash compute the
# same game on any system, so their players can be in one network game (port/platform/dplay.cpp).
#   cmake -DREPO=<repo root> -DOUT=<header> -P game_hash.cmake
file(GLOB sources ${REPO}/Source/*.cpp ${REPO}/Source/*.hpp ${REPO}/Source/*.h
     ${REPO}/port/include/*.h ${REPO}/port/platform/crt.cpp)
list(SORT sources)
set(all "")
foreach(f ${sources})
    file(SHA1 ${f} h)
    file(RELATIVE_PATH rel ${REPO} ${f})
    string(APPEND all "${rel}:${h}\n")
endforeach()
string(SHA1 hash "${all}")
set(content "// Generated by port/tools/game_hash.cmake\n#define GTA2_GAME_HASH \"${hash}\"\n")
if (EXISTS ${OUT})
    file(READ ${OUT} old)
endif()
if (NOT old STREQUAL content)
    file(WRITE ${OUT} "${content}")
endif()
