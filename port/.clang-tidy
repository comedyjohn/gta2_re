# clang-tidy for port/game, port/platform and port/tests (port/refactor/1-tooling.md §1.5).
# Run: ~/.venvs/gta2-refactor/bin/clang-tidy -p build_port/clang64 port/game/rng.cpp
# The ratchet (port/tools/refactor/tidy_ratchet.py) judges the findings per file and check; the
# phase in the comments is the phase of port/refactor/ that brings the check to zero.
#
# Disabled for good:
#   modernize-use-trailing-return-type, modernize-return-braced-init-list: style
#   cppcoreguidelines-avoid-do-while: do while is fine
#   readability-identifier-length, readability-magic-numbers, cppcoreguidelines-avoid-magic-numbers:
#       phase 2 names the constants; the check is too noisy on game tuning values
#   bugprone-easily-swappable-parameters: phase 3's strong types solve it properly
#   modernize-use-using: on typedef struct blocks and 3rdParty headers it drops calling conventions
#       and expands macros
# readability-identifier-naming (the rules of port/STYLE.md) is off here: the code still carries the
# original names. Each subsystem directory that has been renamed gets its own .clang-tidy with
# `InheritParentConfig: true` and `Checks: 'readability-identifier-naming'` (phase 2, step 8).
Checks: >
  -*,
  bugprone-*,
  cert-err33-c,
  cert-err58-cpp,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -modernize-return-braced-init-list,
  -modernize-use-using,
  -cppcoreguidelines-avoid-do-while,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -readability-identifier-naming
WarningsAsErrors: ''
HeaderFilterRegex: 'port/(game|platform|tests)/'
CheckOptions:
  - key: readability-function-size.LineThreshold
    value: '150'
  - key: readability-function-cognitive-complexity.Threshold
    value: '40'
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.EnumCase
    value: CamelCase
  - key: readability-identifier-naming.TypeAliasCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: CamelCase
  - key: readability-identifier-naming.MethodCase
    value: CamelCase
  - key: readability-identifier-naming.PrivateMemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: '_'
  - key: readability-identifier-naming.ProtectedMemberCase
    value: lower_case
  - key: readability-identifier-naming.ProtectedMemberSuffix
    value: '_'
  - key: readability-identifier-naming.PublicMemberCase
    value: lower_case
  # members of a class with member functions end in `_` even while they are public (STYLE.md)
  - key: readability-identifier-naming.PublicMemberIgnoredRegexp
    value: '^[a-z][a-z0-9]*(_[a-z0-9]+)*_$'
  - key: readability-identifier-naming.LocalVariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.ConstexprVariableCase
    value: CamelCase
  - key: readability-identifier-naming.ConstexprVariablePrefix
    value: k
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  - key: readability-identifier-naming.EnumConstantPrefix
    value: k
  - key: readability-identifier-naming.GlobalVariableCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalVariablePrefix
    value: g
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
